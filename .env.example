# Copy to .env for local development. Placeholders only: never commit real secrets.
#
# Docker Compose reads this file (make dev). The API also reads these variables when run
# outside Docker (make api), with hosts pointing at localhost.

# local | test | staging | production
APP_ENV=local

# PostgreSQL 17. Plain postgresql:// URLs are accepted and get the psycopg driver added.
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://vietnamcv:change-me-local-only@localhost:5432/vietnamcv

# Redis (Celery broker and RedBeat lock). CELERY_BROKER_URL defaults to REDIS_URL.
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=

LOG_LEVEL=INFO
# false prints readable console logs; production uses JSON.
LOG_JSON=false

# Comma-separated browser origins allowed to call the API directly.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Development-only fixture identities (X-Dev-Principal header). Refused in staging/production.
DEV_AUTH_ENABLED=true

# Keys the HMAC that turns visitor IPs into rate-limit fingerprints (raw IPs are never
# stored). Required, and secret, in staging and production.
CLIENT_FINGERPRINT_SECRET=local-only-fingerprint-secret

# Signs admin session tokens for the /admin dashboard (ADR-015); at least 32 characters.
# Changing it signs every admin out. Required, and secret, in staging and production:
# generate one with `openssl rand -base64 48`. Create the admin with `scripts/run.sh admin`.
ADMIN_TOKEN_SECRET=local-only-admin-token-secret-change-me

# Google sign-in for comments (ADR-009). Leave empty to hide the Google option.
# Create an OAuth client (Web application) in Google Cloud Console with the redirect URI
# http://localhost:3000/api/auth/google/callback. Compose passes the ID to the API too.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web (Next.js)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:8000
