# Copy to .env for local development. Placeholders only: never commit real secrets.
#
# Docker Compose reads this file (make dev). The API also reads these variables when run
# outside Docker (make api), with hosts pointing at localhost.

# local | test | staging | production
APP_ENV=local

# PostgreSQL 17. Plain postgresql:// URLs are accepted and get the psycopg driver added.
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://vietnamcv:change-me-local-only@localhost:5432/vietnamcv

# Redis (Celery broker and RedBeat lock). CELERY_BROKER_URL defaults to REDIS_URL.
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=

LOG_LEVEL=INFO
# false prints readable console logs; production uses JSON.
LOG_JSON=false

# Comma-separated browser origins allowed to call the API directly.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Development-only fixture identities (X-Dev-Principal header). Refused in staging/production.
DEV_AUTH_ENABLED=true

# Web (Next.js)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:8000
